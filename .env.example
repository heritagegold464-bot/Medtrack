# Supabase project (Settings → API). The anon key is safe in the browser; NEVER put the service-role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Optional: Web Push public key (see DEPLOY.md). Without it, background push is reported as unavailable.
VITE_VAPID_PUBLIC_KEY=
